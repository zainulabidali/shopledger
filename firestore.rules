rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions with safe exists() and get() checks
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
    }

    function getUserRole() {
      return getUserDoc().get('role', '');
    }

    function getUserShopId() {
      return getUserDoc().get('shopId', '');
    }

    function isUserActive() {
      return getUserDoc().get('active', true) == true;
    }

    function isSuperAdmin() {
      return isAuthenticated() && 
             getUserRole() == 'super_admin' && 
             isUserActive();
    }

    function isOwnerOrAdminOf(shopId) {
      return isAuthenticated() && 
             isUserActive() && 
             (getUserRole() == 'super_admin' || 
              ((getUserRole() == 'owner' || getUserRole() == 'admin') && 
               (getUserShopId() == shopId || getUserShopId() == '')));
    }

    function isStaffOf(shopId) {
      return isAuthenticated() && 
             isUserActive() && 
             getUserRole() == 'staff' && 
             (getUserShopId() == shopId || getUserShopId() == '');
    }

    function isDayUnlocked(shopId, dateStr) {
      return !exists(/databases/$(database)/documents/shops/$(shopId)/dailySummary/$(dateStr)) ||
             get(/databases/$(database)/documents/shops/$(shopId)/dailySummary/$(dateStr)).data.get('locked', false) != true;
    }

    // 1. Users Root Collection
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == uid || 
        isSuperAdmin() || 
        getUserRole() in ['owner', 'admin']
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() || 
        getUserRole() in ['owner', 'admin']
      );
    }

    // 2. Invitations Root Collection
    match /invitations/{token} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        isSuperAdmin() || 
        getUserRole() in ['owner', 'admin']
      );
      allow update: if true;
      allow delete: if isAuthenticated() && (
        isSuperAdmin() || 
        getUserRole() in ['owner', 'admin']
      );
    }

    // 3. Shops Root Collection
    match /shops/{shopId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        isOwnerOrAdminOf(shopId) || 
        isStaffOf(shopId)
      );
      allow write: if isAuthenticated() && (
        isSuperAdmin() || 
        isOwnerOrAdminOf(shopId)
      );

      // Subcollection: Transactions
      match /transactions/{txId} {
        allow read: if isAuthenticated() && (
          isSuperAdmin() || 
          isOwnerOrAdminOf(shopId) || 
          isStaffOf(shopId) ||
          resource.data.get('staffUid', '') == request.auth.uid
        );

        allow create: if isAuthenticated()
                      && (isSuperAdmin() || isOwnerOrAdminOf(shopId) || isStaffOf(shopId) || getUserRole() in ['owner', 'admin', 'staff', 'super_admin'])
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0
                      && request.resource.data.type in ['sale', 'purchase', 'expense']
                      && request.resource.data.paymentMode in ['cash', 'upi', 'card']
                      && isDayUnlocked(shopId, request.resource.data.date);

        allow update, delete: if isAuthenticated()
                              && (isSuperAdmin() || isOwnerOrAdminOf(shopId))
                              && isDayUnlocked(shopId, resource.data.date);
      }

      // Subcollection: Daily Summaries
      match /dailySummary/{date} {
        allow read: if isAuthenticated() && (
          isSuperAdmin() || 
          isOwnerOrAdminOf(shopId) || 
          isStaffOf(shopId)
        );
        allow write: if isAuthenticated() && (
          isSuperAdmin() || 
          isOwnerOrAdminOf(shopId) || 
          isStaffOf(shopId) ||
          getUserRole() in ['owner', 'admin', 'staff', 'super_admin']
        ) && isDayUnlocked(shopId, date);
      }

      // Subcollection: Monthly Summaries
      match /monthlySummary/{month} {
        allow read: if isAuthenticated() && (
          isSuperAdmin() || 
          isOwnerOrAdminOf(shopId) || 
          isStaffOf(shopId)
        );
        allow write: if isAuthenticated() && (
          isSuperAdmin() || 
          isOwnerOrAdminOf(shopId) || 
          isStaffOf(shopId) ||
          getUserRole() in ['owner', 'admin', 'staff', 'super_admin']
        );
      }
    }
  }
}
